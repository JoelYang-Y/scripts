# ==============================================================================
# Hermes Agent 主配置文件模板 (config.yaml)
# 路径: ~/.hermes/config.yaml
# ==============================================================================

# 1. 核心模型配置
model:
  default: google/gemini-3.7-flash
  provider: vertex
  base_url: ''

fallback_providers:
  - provider: vertex
    model: google/gemini-3.7-flash
  - provider: deepseek
    model: deepseek-chat

# 2. 默认工具集加载
toolsets:
  - hermes-cli

# 3. Agent 执行引擎策略
agent:
  max_turns: 150
  gateway_timeout: 1800
  restart_drain_timeout: 60
  api_max_retries: 3
  tool_use_enforcement: auto
  task_completion_guidance: true
  parallel_tool_call_guidance: true
  environment_probe: true
  coding_context: auto
  clarify_timeout: 600
  gateway_notify_interval: 600
  gateway_auto_continue_freshness: 3600
  image_input_mode: auto
  disabled_toolsets: []
  verbose: false
  reasoning_effort: high

# 4. 终端执行环境
terminal:
  backend: local
  cwd: .
  timeout: 180
  auto_source_bashrc: true
  persistent_shell: true
  lifetime_seconds: 300

# 5. 联网搜索与抓取
web:
  backend: tavily
  search_backend: ''
  extract_backend: ''
  use_gateway: false

# 6. 上下文压缩与剪枝 (保障超长对话不超 Token 限制)
compression:
  enabled: true
  threshold: 0.5
  target_ratio: 0.2
  protect_last_n: 20
  hygiene_hard_message_limit: 400
  protect_first_n: 3
  abort_on_summary_failure: false
  in_place: false

# 7. 辅助小模型路由 (Auxiliary Routing)
auxiliary:
  vision:
    provider: auto
    model: ''
    timeout: 120
  web_extract:
    provider: auto
    model: ''
    timeout: 360
  compression:
    provider: vertex
    model: google/gemini-3.1-flash-lite
    timeout: 120
  approval:
    provider: auto
    model: ''
    timeout: 30
  session_search:
    provider: auto
    model: ''
    timeout: 30
  curator:
    provider: auto
    model: ''
    timeout: 600

# 8. 记忆系统配置 (Mem0 OSS 独立自建)
memory:
  memory_enabled: true
  user_profile_enabled: true
  write_approval: true
  memory_char_limit: 2200
  user_char_limit: 1375
  nudge_interval: 0
  provider: mem0
  flush_min_turns: 6

# 9. 智能体任务委派 (Delegation / Subagents)
delegation:
  max_iterations: 250
  child_timeout_seconds: 600
  max_concurrent_children: 10
  max_spawn_depth: 1
  orchestrator_enabled: true
  subagent_auto_approve: false
  default_toolsets:
    - terminal
    - file
    - web

# 10. 技能管理与自动化策展 (Curator)
skills:
  template_vars: true
  inline_shell: false
  guard_agent_created: false
  write_approval: false

curator:
  enabled: true
  interval_hours: 168
  min_idle_hours: 2
  stale_after_days: 30
  archive_after_days: 90
  consolidate: false
  prune_builtins: true
  backup:
    enabled: true
    keep: 5

# 11. 语音配置 (TTS / STT)
tts:
  provider: edge
  edge:
    voice: zh-CN-XiaoxiaoNeural

stt:
  enabled: true
  provider: local
  local:
    model: base
