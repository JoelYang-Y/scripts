# ==============================================================================
# Hermes Agent 核心环境变量与密钥配置模板 (.env)
# 复制此文件为 ~/.hermes/.env 并填入实际 Key
# ==============================================================================

# [核心模型提供商 - Google Vertex AI]
GOOGLE_APPLICATION_CREDENTIALS=/Users/YOUR_USERNAME/.hermes/vertex-service-account.json
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
# 或 Google Gemini 原生 API Key
GOOGLE_API_KEY=AIzaSy...

# [辅助与思考模型 - DeepSeek]
DEEPSEEK_API_KEY=sk-...

# [聚合路由与备用模型 - OpenRouter]
OPENROUTER_API_KEY=sk-or-v1-...

# [语音能力 (TTS / STT)]
# MiniMax 语音 (TTS 首选)
MINIMAX_API_KEY=eyJ...
MINIMAX_GROUP_ID=123456789...
# Edge-TTS (本地免费，无需 Key)
# Groq Whisper 极速语音转文字 (STT)
GROQ_API_KEY=gsk_...

# [联网与搜索工具 (Tavily)]
TAVILY_API_KEY=tvly-...

# [多端网关 (Gateway)]
# Telegram Bot
TELEGRAM_BOT_TOKEN=1234567890:ABCdef...
TELEGRAM_ALLOWED_USERS=123456789
TELEGRAM_HOME_CHAT_ID=-1001234567890

# [安全与行为规范]
HERMES_REDACT_SECRETS=true
HERMES_YOLO_MODE=0
