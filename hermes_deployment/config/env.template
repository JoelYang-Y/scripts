# ==============================================================================
# Hermes Agent 环境变量与密钥模板 (.env)
# 基线：2026-11-11 实测（键名为本机 ~/.hermes/.env 真实口径）
# 路径：~/.hermes/.env（profile 级：~/.hermes/profiles/<name>/.env）
#
# 纪律：
#   - 本文件只放"键"，真实值永不入库。填好后 .env 必须留在本机。
#   - 新建 profile 时至少复制 MEM0_MODE 与 DEEPSEEK_API_KEY 两项，
#     否则 mem0 报 Missing MEM0_API_KEY 并回落 platform 模式。
# ==============================================================================

# ------------------------------------------------------------------------------
# [1] 核心推理模型（当前唯一主力，必填）
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-<DEEPSEEK_KEY>
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ------------------------------------------------------------------------------
# [2] 记忆系统（必填，缺失即 mem0 不可用）
# ------------------------------------------------------------------------------
MEM0_MODE=oss

# ------------------------------------------------------------------------------
# [3] 联网检索（web / web_search 走 Tavily）
# ------------------------------------------------------------------------------
TAVILY_API_KEY=tvly-<TAVILY_KEY>
# SERPER_API_KEY=<SERPER_KEY>          # 备用搜索后端，可选

# ------------------------------------------------------------------------------
# [4] 其他模型供应商（可选，仅在使用对应模型/转售线路时需要）
# ------------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-<KEY>
# OPENAI_API_KEY=sk-<KEY>
# ANTHROPIC_API_KEY=sk-ant-<KEY>

# ------------------------------------------------------------------------------
# [5] 多端网关
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=<BOT_ID>:<BOT_SECRET>
TELEGRAM_ALLOWED_USERS=<TELEGRAM_USER_ID>     # 白名单，逗号分隔
# API Server（本机回环，仅 HermesPilot/桌面端使用）
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_KEY=<RANDOM_LONG_KEY>              # 与 config.yaml 的 platforms.api_server.extra.key 一致

# ------------------------------------------------------------------------------
# [6] 本地工作区与终端
# ------------------------------------------------------------------------------
OBSIDIAN_VAULT_PATH=<HOME>/Documents/ObsidianVault
TERMINAL_TIMEOUT=180
TERMINAL_LIFETIME_SECONDS=300

# ------------------------------------------------------------------------------
# [7] 浏览器自动化（本地 Chrome / 云端二选一）
# ------------------------------------------------------------------------------
AGENT_BROWSER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
BROWSER_SESSION_TIMEOUT=300
BROWSER_INACTIVITY_TIMEOUT=120
# BROWSERBASE_PROXIES=true
# BROWSERBASE_ADVANCED_STEALTH=true

# ------------------------------------------------------------------------------
# [8] 调试开关（平时保持关闭）
# ------------------------------------------------------------------------------
WEB_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
IMAGE_TOOLS_DEBUG=false
MOA_TOOLS_DEBUG=false

# ------------------------------------------------------------------------------
# [9] 特殊权限（谨慎）
# ------------------------------------------------------------------------------
# SUDO_PASSWORD=<...>       # 仅在本机确需免交互 sudo 时填写；不得入库或转发
