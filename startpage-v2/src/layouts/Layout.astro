---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Joel's Life" } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{title}</title>
  <link rel="icon" type="image/png" href="/avatar.png">
  <link rel="apple-touch-icon" href="/avatar.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Joel's Life">
  <meta name="theme-color" content="#060913">
  <!-- Lucide Icons -->
  <script is:inline src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="theme-nebula flex flex-col items-center justify-between p-4 sm:p-6 md:p-10 selection:bg-blue-500 selection:text-white">
  <slot />
  
  <script is:inline>
    // 初始化 Lucide 图标
    if (window.lucide) {
      window.lucide.createIcons();
    }
  </script>
</body>
</html>
